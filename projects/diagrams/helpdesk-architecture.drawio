<mxfile host="drawio">
  <diagram id="helpdesk-architecture" name="Campus helpdesk agent">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="960" pageHeight="560" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Capstone: the campus helpdesk agent, and which project builds each part" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="student" value="&lt;b&gt;Student&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;When is my DBMS exam, and is the library open on Sunday?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b636e;fontColor=#1f2328;fontSize=14;arcSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="230" width="190" height="130" as="geometry" />
        </mxCell>

        <mxCell id="agent" value="&lt;b&gt;Helpdesk agent&lt;/b&gt;&lt;br&gt;LLM + system prompt&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Decides: answer directly, search the FAQ, or call a tool&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#ffe4d1&quot;&gt;Projects 1 + 6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=16;arcSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="210" width="230" height="170" as="geometry" />
        </mxCell>

        <mxCell id="mem" value="&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;Chat history re-sent each turn&lt;br&gt;&lt;font color=&quot;#5b636e&quot; style=&quot;font-size:12px&quot;&gt;Project 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=14;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="70" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="guard" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;Say &quot;I don't know&quot;, refuse unsafe asks, no private data&lt;br&gt;&lt;font color=&quot;#5b636e&quot; style=&quot;font-size:12px&quot;&gt;Session 5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9ee;strokeColor=#be123c;fontColor=#1f2328;fontSize=14;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="440" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rag" value="&lt;b&gt;RAG: college FAQ &amp;amp; syllabus&lt;/b&gt;&lt;br&gt;PDFs → chunks → embeddings → vector DB&lt;br&gt;&lt;font color=&quot;#5b636e&quot; style=&quot;font-size:12px&quot;&gt;Project 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=14;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="tool" value="&lt;b&gt;Tool: timetable API&lt;/b&gt;&lt;br&gt;get_exam_date(subject)&lt;br&gt;exposed as an MCP server&lt;br&gt;&lt;font color=&quot;#5b636e&quot; style=&quot;font-size:12px&quot;&gt;Project 4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1ebff;strokeColor=#6d28d9;fontColor=#1f2328;fontSize=14;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="deploy" value="&lt;b&gt;Deploy as an API&lt;/b&gt;&lt;br&gt;FastAPI + serverless / container&lt;br&gt;&lt;font color=&quot;#5b636e&quot; style=&quot;font-size:12px&quot;&gt;Session 9 (stretch goal)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=#5b636e;dashed=1;fontColor=#1f2328;fontSize=14;arcSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="380" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="question" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;fontSize=12;fontColor=#5b636e;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="student" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#1d4ed8;strokeWidth=2;" edge="1" parent="1" source="agent" target="mem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#be123c;strokeWidth=2;dashed=1;" edge="1" parent="1" source="guard" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="search" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#15803d;strokeWidth=2;fontSize=12;fontColor=#15803d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="rag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="call tool" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#6d28d9;strokeWidth=2;fontSize=12;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="agent" target="tool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=none;html=1;strokeColor=#5b636e;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="agent" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
