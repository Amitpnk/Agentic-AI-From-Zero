<mxfile host="drawio">
  <diagram id="prompt-anatomy" name="Anatomy of a good prompt">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="780" pageHeight="620" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Anatomy of a good prompt" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Example: a helpdesk bot answering exam questions" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#5b636e;" vertex="1" parent="1">
          <mxGeometry x="20" y="42" width="500" height="24" as="geometry" />
        </mxCell>

        <!-- Row 1: Role -->
        <mxCell id="l1" value="&lt;b&gt;1. Role&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Who should the AI be?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=15;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="You are a friendly helpdesk assistant for ABC Engineering College." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="540" height="64" as="geometry" />
        </mxCell>

        <!-- Row 2: Task -->
        <mxCell id="l2" value="&lt;b&gt;2. Task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;What exactly to do?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=15;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="154" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Answer the student's question about exam dates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="154" width="540" height="64" as="geometry" />
        </mxCell>

        <!-- Row 3: Context -->
        <mxCell id="l3" value="&lt;b&gt;3. Context&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;What info does it need?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;fontColor=#ffffff;fontSize=15;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="228" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Here is the exam timetable:&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;DBMS - 12 Dec, 10 AM, Hall B | OS - 14 Dec, 2 PM, Hall A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="228" width="540" height="64" as="geometry" />
        </mxCell>

        <!-- Row 4: Examples -->
        <mxCell id="l4" value="&lt;b&gt;4. Examples&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Show, don't just tell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6d28d9;strokeColor=none;fontColor=#ffffff;fontSize=15;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="302" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Q: When is DBMS?&amp;nbsp; → &amp;nbsp;A: DBMS is on 12 Dec at 10 AM in Hall B." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1ebff;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="302" width="540" height="64" as="geometry" />
        </mxCell>

        <!-- Row 5: Format -->
        <mxCell id="l5" value="&lt;b&gt;5. Format&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;What should the answer look like?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e7490;strokeColor=none;fontColor=#ffffff;fontSize=15;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="376" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="Reply in one short sentence, in simple English." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f6fa;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="376" width="540" height="64" as="geometry" />
        </mxCell>

        <!-- Row 6: Constraints -->
        <mxCell id="l6" value="&lt;b&gt;6. Rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;What must it never do?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#be123c;strokeColor=none;fontColor=#ffffff;fontSize=15;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="450" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="If the answer is not in the timetable, say &quot;I don't know, please check with the exam cell.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9ee;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="450" width="540" height="64" as="geometry" />
        </mxCell>

        <mxCell id="tip" value="&lt;b&gt;Tip:&lt;/b&gt; you don't need all six every time. Start with the &lt;b&gt;Task&lt;/b&gt;, then add parts until the answer is good." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e3e0d8;dashed=1;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="530" width="740" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
