<mxfile host="drawio">
  <diagram id="api-call" name="One API call">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="960" pageHeight="360" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="One API call: your code sends a request, the model sends back a response" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="code" value="&lt;b&gt;Your Python code&lt;/b&gt;&lt;br&gt;&lt;br&gt;Google Colab, your laptop, or a server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b636e;fontColor=#1f2328;fontSize=15;arcSize=10;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="190" height="150" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;LLM API&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;The model running on the provider's servers (Google, Groq, OpenAI, Anthropic)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontSize=15;arcSize=10;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="110" width="190" height="150" as="geometry" />
        </mxCell>

        <mxCell id="req" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;• &lt;b&gt;API key&lt;/b&gt;: proves it's you&lt;br&gt;• &lt;b&gt;model&lt;/b&gt;: which LLM to use&lt;br&gt;• &lt;b&gt;messages&lt;/b&gt;: system prompt + chat so far + new question&lt;br&gt;• &lt;b&gt;settings&lt;/b&gt;: temperature, max tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=14;align=left;verticalAlign=top;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="res" value="&lt;b&gt;Response&lt;/b&gt;&lt;br&gt;• &lt;b&gt;text&lt;/b&gt;: the answer&lt;br&gt;• &lt;b&gt;usage&lt;/b&gt;: input tokens + output tokens (this is what you pay for)&lt;br&gt;• &lt;b&gt;finish reason&lt;/b&gt;: done, too long, or blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=14;align=left;verticalAlign=top;spacing=10;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="270" y="200" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;strokeColor=#1d4ed8;strokeWidth=2;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="code" target="req"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;strokeColor=#1d4ed8;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="req" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;strokeColor=#15803d;strokeWidth=2;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;strokeColor=#15803d;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="res" target="code"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
