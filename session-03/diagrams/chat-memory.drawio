<mxfile host="drawio">
  <diagram id="chat-memory" name="How chat memory works">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="440" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="The model forgets. Your code remembers by re-sending the whole chat." style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="960" height="36" as="geometry" />
        </mxCell>
        <mxCell id="hdr" value="What your code sends in each request" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#5b636e;" vertex="1" parent="1">
          <mxGeometry x="120" y="50" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hdr2" value="Model replies" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#5b636e;" vertex="1" parent="1">
          <mxGeometry x="790" y="50" width="190" height="24" as="geometry" />
        </mxCell>

        <!-- Turn 1 -->
        <mxCell id="t1" value="Turn 1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="85" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t1s" value="&lt;b&gt;system&lt;/b&gt;&lt;br&gt;You are CampusBuddy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=#5b636e;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="85" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t1u" value="&lt;b&gt;user&lt;/b&gt;&lt;br&gt;Hi, I'm Priya from CSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="85" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t1r" value="Hello Priya! How can I help?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="85" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t1e" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;dashed=1;" edge="1" parent="1" source="t1u" target="t1r"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Turn 2 -->
        <mxCell id="t2" value="Turn 2" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="160" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t2s" value="&lt;b&gt;system&lt;/b&gt;&lt;br&gt;You are CampusBuddy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=#5b636e;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="160" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t2u" value="&lt;b&gt;user&lt;/b&gt;&lt;br&gt;Hi, I'm Priya from CSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="160" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t2m" value="&lt;b&gt;model&lt;/b&gt;&lt;br&gt;Hello Priya! How can I help?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="440" y="160" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t2q" value="&lt;b&gt;user&lt;/b&gt;&lt;br&gt;What's my name and branch?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t2r" value="You're Priya from CSE. ✅" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="160" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t2e" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;dashed=1;" edge="1" parent="1" source="t2q" target="t2r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t2note" value="Turn 1 is sent again, so the model can &quot;remember&quot; it" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#15803d;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="212" width="460" height="22" as="geometry" />
        </mxCell>

        <!-- Divider -->
        <mxCell id="div" style="endArrow=none;html=1;strokeColor=#e3e0d8;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="255" as="sourcePoint" />
            <mxPoint x="980" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Without memory -->
        <mxCell id="t3" value="&lt;font color=&quot;#be123c&quot;&gt;Turn 2,&lt;br&gt;no memory&lt;/font&gt;" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="275" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t3s" value="&lt;b&gt;system&lt;/b&gt;&lt;br&gt;You are CampusBuddy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=#5b636e;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="275" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t3q" value="&lt;b&gt;user&lt;/b&gt;&lt;br&gt;What's my name and branch?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="275" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t3r" value="Sorry, I don't know your name. ❌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9ee;strokeColor=#be123c;fontColor=#1f2328;fontSize=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="275" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t3e" style="endArrow=block;endFill=1;html=1;strokeColor=#be123c;strokeWidth=2;dashed=1;" edge="1" parent="1" source="t3q" target="t3r"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="foot" value="&lt;b&gt;Trade-off:&lt;/b&gt; every turn re-sends more tokens, so long chats cost more and can overflow the context window. Fix: keep only the last N messages, or summarise old ones." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e3e0d8;dashed=1;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="960" height="56" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
