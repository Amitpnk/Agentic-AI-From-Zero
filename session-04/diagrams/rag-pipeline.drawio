<mxfile host="drawio">
  <diagram id="rag-pipeline" name="RAG pipeline">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1080" pageHeight="520" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="RAG in two parts: prepare the documents once, then answer every question" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1040" height="36" as="geometry" />
        </mxCell>

        <!-- Lane 1 -->
        <mxCell id="lane1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbf8;strokeColor=#15803d;dashed=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="1040" height="170" as="geometry" />
        </mxCell>
        <mxCell id="lane1t" value="&lt;b&gt;1. Indexing&lt;/b&gt; (once, or when documents change)" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="36" y="66" width="500" height="26" as="geometry" />
        </mxCell>

        <mxCell id="docs" value="&lt;b&gt;Documents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Syllabus PDF, FAQ, placement rules&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffffff;strokeColor=#5b636e;fontColor=#1f2328;fontSize=14;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="chunk" value="&lt;b&gt;Chunk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Split into small pieces (~100-300 words)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="embed1" value="&lt;b&gt;Embed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Turn each chunk into a vector (Session 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Vector database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Stores vectors + text + source&lt;br&gt;(Chroma, FAISS...)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="840" y="95" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a1" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="docs" target="chunk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="chunk" target="embed1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="embed1" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Lane 2 -->
        <mxCell id="lane2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf8ff;strokeColor=#6d28d9;dashed=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="1040" height="230" as="geometry" />
        </mxCell>
        <mxCell id="lane2t" value="&lt;b&gt;2. Answering&lt;/b&gt; (every question)" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;fontColor=#6d28d9;" vertex="1" parent="1">
          <mxGeometry x="36" y="256" width="500" height="26" as="geometry" />
        </mxCell>

        <mxCell id="q" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&quot;Is the library open on Sunday?&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b636e;fontColor=#1f2328;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="embed2" value="&lt;b&gt;Embed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Same embedding model as the chunks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="300" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="retrieve" value="&lt;b&gt;Retrieve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Find the top 3 closest chunks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="&lt;b&gt;Generate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;LLM gets: rules + chunks + question&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontSize=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="300" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ans" value="&lt;b&gt;Answer with source:&lt;/b&gt; &quot;The library is closed on Sundays, except in December and May, when it opens 10 AM to 4 PM. [Library]&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=13;arcSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="410" width="730" height="54" as="geometry" />
        </mxCell>
        <mxCell id="b1" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="q" target="embed2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="embed2" target="retrieve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b3" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="retrieve" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;strokeColor=#c2410c;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gen" target="ans"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="400" /><mxPoint x="1045" y="400" /><mxPoint x="1045" y="437" /></Array></mxGeometry></mxCell>
        <mxCell id="search" value="search" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#15803d;strokeWidth=2;dashed=1;fontSize=12;fontColor=#15803d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="retrieve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="245" /><mxPoint x="650" y="245" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
