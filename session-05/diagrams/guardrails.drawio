<mxfile host="drawio">
  <diagram id="guardrails" name="Layers of guardrails">
    <mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1060" pageHeight="380" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Guardrails: checks before and after the model, not just a better prompt" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1020" height="36" as="geometry" />
        </mxCell>

        <mxCell id="user" value="&lt;b&gt;Student&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b636e;fontColor=#1f2328;fontSize=15;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="100" height="70" as="geometry" />
        </mxCell>

        <mxCell id="in" value="&lt;b&gt;1. Input checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;• On topic?&lt;br&gt;• Looks like injection?&lt;br&gt;• Mask phone, Aadhaar, email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="95" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="model" value="&lt;b&gt;2. The model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;• Clear system prompt&lt;br&gt;• RAG with sources&lt;br&gt;• Low temperature&lt;br&gt;• Tools with least privilege&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="95" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="out" value="&lt;b&gt;3. Output checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;• Has a source?&lt;br&gt;• Any personal data?&lt;br&gt;• Safe and on topic?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="95" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="human" value="&lt;b&gt;4. Human review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;For high-stakes actions: marks, money, emails to everyone&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;arcSize=10;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="95" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="user" target="in"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="in" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="model" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="out" target="human"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="blocklbl" value="Blocked? Reply politely: &quot;Sorry, I can only help with college questions.&quot;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#be123c;" vertex="1" parent="1">
          <mxGeometry x="270" y="58" width="600" height="22" as="geometry" />
        </mxCell>
        <mxCell id="block" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;strokeColor=#be123c;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="in" target="user">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="80" /><mxPoint x="70" y="80" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="log" value="&lt;b&gt;5. Log and monitor everything&lt;/b&gt;: questions, retrieved chunks, answers, blocked attempts. Review weekly and add new failures to your test set." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=#5b636e;dashed=1;fontColor=#1f2328;fontSize=14;arcSize=14;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="240" width="880" height="50" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="No single layer is perfect. Together, they make failures rare and small." style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#5b636e;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="1020" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
