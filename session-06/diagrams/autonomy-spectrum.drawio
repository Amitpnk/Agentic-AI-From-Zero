<mxfile host="drawio">
  <diagram id="autonomy-spectrum" name="From chatbot to agent">
    <mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="420" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="From chatbot to agent: who decides the next step?" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="axis" value="more freedom for the LLM = more power, but more cost, risk and testing" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;fontSize=13;fontColor=#5b636e;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="66" as="sourcePoint" />
            <mxPoint x="980" y="66" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="h1" value="Chatbot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5b636e;strokeColor=none;fontColor=#ffffff;fontSize=17;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="225" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;One LLM call per question.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Session 3: CampusBuddy with memory.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;&lt;b&gt;Next step decided by:&lt;/b&gt; nobody. Question in, answer out.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;verticalAlign=top;spacing=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="146" width="225" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h2" value="RAG bot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;fontColor=#ffffff;fontSize=17;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="265" y="90" width="225" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Always: search, then answer.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Session 4: answers from the college FAQ.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;&lt;b&gt;Next step decided by:&lt;/b&gt; your code. Same two steps every time.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;verticalAlign=top;spacing=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="265" y="146" width="225" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h3" value="Workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=17;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="510" y="90" width="225" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Several LLM calls and tools, in an order you wrote.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Classify complaint → route → draft reply.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;&lt;b&gt;Next step decided by:&lt;/b&gt; your code (maybe with an if/else).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;verticalAlign=top;spacing=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="146" width="225" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h4" value="Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=17;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="755" y="90" width="225" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;The LLM picks tools in a loop until the goal is done.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;Check my exam, then book a library room if it's open.&quot;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5b636e&quot;&gt;&lt;b&gt;Next step decided by:&lt;/b&gt; the LLM itself.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=none;fontColor=#1f2328;fontSize=14;align=left;verticalAlign=top;spacing=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="755" y="146" width="225" height="200" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Day 1" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="20" y="356" width="470" height="24" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Day 2" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#c2410c;" vertex="1" parent="1">
          <mxGeometry x="510" y="356" width="470" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
