<mxfile host="drawio">
  <diagram id="mcp-architecture" name="MCP host, client, server">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="960" pageHeight="440" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="MCP in one picture: host, clients, servers" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="host" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f7f8;strokeColor=#1f2328;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="380" height="330" as="geometry" />
        </mxCell>
        <mxCell id="hostt" value="&lt;b&gt;Host&lt;/b&gt;: the AI app&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5b636e&quot;&gt;Claude Desktop, VS Code, Cursor, or your own agent&lt;/font&gt;" style="text;html=1;fontSize=15;align=left;verticalAlign=top;fontColor=#1f2328;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="36" y="68" width="350" height="50" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;LLM&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cl1" value="&lt;b&gt;MCP client&lt;/b&gt; #1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=13;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="130" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cl2" value="&lt;b&gt;MCP client&lt;/b&gt; #2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=13;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="205" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cl3" value="&lt;b&gt;MCP client&lt;/b&gt; #3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=#1d4ed8;fontColor=#1f2328;fontSize=13;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="220" y="280" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="l1" style="endArrow=none;html=1;strokeColor=#5b636e;strokeWidth=1.5;" edge="1" parent="1" source="llm" target="cl1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l2" style="endArrow=none;html=1;strokeColor=#5b636e;strokeWidth=1.5;" edge="1" parent="1" source="llm" target="cl2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l3" style="endArrow=none;html=1;strokeColor=#5b636e;strokeWidth=1.5;" edge="1" parent="1" source="llm" target="cl3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hostn" value="One client per server" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#5b636e;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="340" width="160" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;campus&lt;/b&gt; server (yours!)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;get_exam_date · get_library_hours · book_study_room · get_weather&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=#c2410c;fontColor=#1f2328;fontSize=14;arcSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;GitHub&lt;/b&gt; server&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;search code · open issue · read PR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=#5b636e;fontColor=#1f2328;fontSize=14;arcSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Files&lt;/b&gt; server&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;read file · list folder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=#5b636e;fontColor=#1f2328;fontSize=14;arcSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="270" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="stdio (local)" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#c2410c;strokeWidth=2;fontSize=12;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cl1" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2" value="HTTP (remote)" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;fontSize=12;fontColor=#5b636e;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cl2" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3" value="stdio (local)" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;fontSize=12;fontColor=#5b636e;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cl3" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="srvt" value="&lt;b&gt;Servers&lt;/b&gt; offer &lt;b&gt;tools&lt;/b&gt; (actions), &lt;b&gt;resources&lt;/b&gt; (data to read) and &lt;b&gt;prompts&lt;/b&gt; (templates)" style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="600" y="64" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="The host asks the user before running tools. Only connect servers you trust: a server runs code on your machine." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#be123c;" vertex="1" parent="1">
          <mxGeometry x="600" y="340" width="340" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
