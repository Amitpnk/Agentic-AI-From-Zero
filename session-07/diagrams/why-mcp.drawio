        <mxCell id="foot" value="Like &lt;b&gt;USB-C&lt;/b&gt;: any charger works with any phone. Build your tool as an MCP server once, and every MCP app can use it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e3e0d8;dashed=1;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=14;" vertex="1" parent="1">
