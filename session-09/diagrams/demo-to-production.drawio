<mxfile host="drawio">
  <diagram id="demo-to-production" name="Demo to production">
    <mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1060" pageHeight="420" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="From demo to production: five things to add" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="demo" value="&lt;b&gt;Demo&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Works on my laptop.&lt;br&gt;Tried 3 questions.&lt;br&gt;I watch every answer.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f1ec;strokeColor=#5b636e;fontColor=#1f2328;fontSize=15;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="130" height="190" as="geometry" />
        </mxCell>

        <mxCell id="h1" value="📏 Evaluate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="180" y="70" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Test set of real questions&lt;br&gt;&lt;br&gt;Correct? Grounded? Right tool? Refuses bad asks?&lt;br&gt;&lt;br&gt;Re-run on every change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=none;fontColor=#1f2328;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="116" width="140" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h2" value="🔍 Observe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="A trace for every request&lt;br&gt;&lt;br&gt;Dashboards: latency, errors, cost, 👎 rate&lt;br&gt;&lt;br&gt;Alerts when things break" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=none;fontColor=#1f2328;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="116" width="140" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h3" value="💰 Cost &amp;amp; speed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6d28d9;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="480" y="70" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Smaller model where possible&lt;br&gt;&lt;br&gt;Fewer steps, caching, streaming&lt;br&gt;&lt;br&gt;Budgets and limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1ebff;strokeColor=none;fontColor=#1f2328;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="116" width="140" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h4" value="🛡️ Safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#be123c;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="630" y="70" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Least-privilege tools&lt;br&gt;&lt;br&gt;Login or API key, rate limits&lt;br&gt;&lt;br&gt;Secrets manager, human approval, kill switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe9ee;strokeColor=none;fontColor=#1f2328;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="630" y="116" width="140" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h5" value="🚀 Deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=15;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="780" y="70" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Wrap it in an API&lt;br&gt;&lt;br&gt;Container on serverless (Cloud Run, App Runner...)&lt;br&gt;&lt;br&gt;Pilot first, then everyone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=none;fontColor=#1f2328;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="116" width="140" height="200" as="geometry" />
        </mxCell>

        <mxCell id="prod" value="&lt;b&gt;Production&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;2,000 students at 9 AM.&lt;br&gt;Questions you never imagined.&lt;br&gt;Nobody watching.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2328;strokeColor=none;fontColor=#ffffff;fontSize=15;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="120" width="110" height="190" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="demo" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="c5" target="prod"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="foot" value="Most AI projects fail here, not in the demo. These five are what make an AI engineer valuable." style="text;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;fontColor=#5b636e;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="1030" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
