<mxfile host="drawio">
  <diagram id="learning-roadmap" name="Your next 90 days">
    <mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="430" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Your next 90 days" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="h1" value="Month 1 · Finish and ship" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803d;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="• Finish the capstone with &lt;b&gt;your&lt;/b&gt; college's documents&lt;br&gt;• Deploy it (Session 9 starter)&lt;br&gt;• README with diagram, demo GIF and eval results&lt;br&gt;• Post it on LinkedIn: what you built and learned&lt;br&gt;• Strengthen Python, Git, SQL, REST APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=none;fontColor=#1f2328;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="116" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h2" value="Month 2 · Go deeper in one track" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d4ed8;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="350" y="60" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Pick &lt;b&gt;one&lt;/b&gt;:&lt;br&gt;• &lt;b&gt;RAG + evals:&lt;/b&gt; hybrid search, re-ranking, a proper eval set&lt;br&gt;• &lt;b&gt;Agents:&lt;/b&gt; LangGraph or an agent SDK, MCP servers&lt;br&gt;• &lt;b&gt;ML foundations:&lt;/b&gt; a full ML / deep learning course&lt;br&gt;• Plus: one cloud (AWS, Azure or GCP) basics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf0ff;strokeColor=none;fontColor=#1f2328;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="116" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="h3" value="Month 3 · Real users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c2410c;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;arcSize=18;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="• Build something for a &lt;b&gt;real person&lt;/b&gt;: a club, a professor, a local shop&lt;br&gt;• Join a hackathon (Smart India Hackathon, college fests)&lt;br&gt;• One open-source contribution&lt;br&gt;• Practise explaining your projects for interviews" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1e8;strokeColor=none;fontColor=#1f2328;fontSize=13;align=left;verticalAlign=top;spacing=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="116" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="foot" value="&lt;b&gt;Rule of thumb:&lt;/b&gt; 3 finished, deployed projects that real people used beat 10 tutorials and any certificate. Spend 1 hour a day, 5 days a week." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e3e0d8;dashed=1;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="334" width="960" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
