<mxfile host="drawio">
  <diagram id="two-day-journey" name="Two days in one picture">
    <mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1060" pageHeight="440" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Two days in one picture: from &quot;what is an LLM?&quot; to a deployed agent" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2328;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1020" height="36" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="&lt;b&gt;Day 1: Generative AI&lt;/b&gt;" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1&lt;/b&gt; How LLMs work&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5b636e&quot;&gt;tokens, embeddings, hallucination&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=13;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="92" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2&lt;/b&gt; Prompt engineering&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5b636e&quot;&gt;6 parts, few-shot, JSON&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=13;arcSize=14;" vertex="1" parent="1">
          <mxGeometry x="230" y="92" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3&lt;/b&gt; LLM APIs&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5b636e&quot;&gt;calls, memory, streaming, cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=13;arcSize=14;" vertex="1" parent="1">
