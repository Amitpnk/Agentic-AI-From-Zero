        <mxCell id="link" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;html=1;strokeColor=#5b636e;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="176" /><mxPoint x="115" y="176" /></Array></mxGeometry></mxCell>

        <mxCell id="proj" value="&lt;b&gt;You built:&lt;/b&gt; ① Prompt Lab · ② Chatbot with memory · ③ RAG over college documents · ④ Timetable agent + MCP server · ⑤ Research team of agents · ⑥ Campus helpdesk agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e3e0d8;dashed=1;fontColor=#1f2328;fontSize=14;align=left;spacingLeft=12;arcSize=12;" vertex="1" parent="1">
