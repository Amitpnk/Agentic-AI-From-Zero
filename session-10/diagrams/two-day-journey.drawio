        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4&lt;/b&gt; RAG&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5b636e&quot;&gt;answers from your documents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f8ee;strokeColor=#15803d;fontColor=#1f2328;fontSize=13;arcSize=14;" vertex="1" parent="1">
